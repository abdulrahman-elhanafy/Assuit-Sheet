#include <iostream>
#include <string>

using namespace std;

int main()
{
    int sizze;
    cin >> sizze;
    int arr[sizze];
    for (auto &&i : arr)
    {
        cin >> i;
    }
    for (int i = 0; i < sizze - 1; i++)
    {
        for (int j = 0; j < sizze - i - 1; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    for (auto &&i : arr)
    {
        cout << i << " ";
    }

    return 0;
}
