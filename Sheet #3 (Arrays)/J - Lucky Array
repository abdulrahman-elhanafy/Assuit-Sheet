#include <iostream>
#include <algorithm>

using namespace std;

int main()
{
    int A;
    cin >> A;
    int arr[A];
    for (auto &&i : arr)
    {
        cin >> i;
    }

    int mini = arr[0];
    for (int i = 1; i < A; i++)
    {
        if (arr[i] < mini)
        {
            mini = arr[i];
        }
    }

    int count = 0;
    for (int i = 0; i < A; i++)
    {
        if (arr[i] == mini)
        {
            count++;
        }
    }

    (count % 2) ? cout << "Lucky" : cout << "Unlucky";

    return 0;
}
