#include <iostream>
#include <cmath>
#include <algorithm>

using namespace std;

int main()
{
    int A;
    cin >> A;
    int arr[A];
    for (int i = 0; i < A; i++)
    {
        cin >> arr[i];
    }
    int count = 0;
    bool isOdd = false;
    int answer = 1e9;
    for (int i = 0; i < A; i++)
    {
        int count = 0;
        int x = arr[i];
        while (!(x % 2))
        {
            x /= 2;
            count++;
        }
        answer = min(answer, count);
    }

    cout << answer;
    return 0;
}
