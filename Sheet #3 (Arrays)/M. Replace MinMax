#include <iostream>
#include <cmath>
#include <algorithm>

using namespace std;

int main()
{
    int A;
    cin >> A;
    int arr[A];
    for (int i = 0; i < A; i++)
    {
        cin >> arr[i];
    }

    int min = arr[0];
    int minIndex = 0;
    int max = arr[0];
    int maxIndex = 0;
    for (int i = 1; i < A; i++)
    {
        if (arr[i] < min)
        {
            min = arr[i];
            minIndex = i;
        }
        if (arr[i] > max)
        {
            max = arr[i];
            maxIndex = i;
        }
    }

    int temp = max;
    arr[maxIndex] = min;
    arr[minIndex] = temp;

    for (auto &&i : arr)
    {
        cout << i << " ";
    }

    return 0;
}
