#include <iostream>
#include <algorithm>

using namespace std;

int main()
{
    int size = 0;
    cin >> size;
    int arr1[size];
    int arr2[size];

    for (int i = 0; i < size; i++)
    {
        cin >> arr1[i];
    }
    for (int i = 0; i < size; i++)
    {
        cin >> arr2[i];
    }

    sort(arr1, arr1 + size);
    sort(arr2, arr2 + size);

    bool theSame = true;

    for (int i = 0; i < size; i++)
    {
        if (arr1[i] != arr2[i])
        {
            theSame = false;
            break;
        }
    }

    if (theSame)
        cout << "yes";
    else
        cout << "no";

    return 0;
}
