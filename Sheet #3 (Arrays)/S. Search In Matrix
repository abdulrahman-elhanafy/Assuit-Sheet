#include <iostream>

using namespace std;

int main()
{
    int N = 0, M = 0;
    cin >> N >> M;
    int arr[N][M];
    for (int i = 0; i < N; i++)
    {
        for (int j = 0; j < M; j++)
        {
            cin >> arr[i][j];
        }
    }
    int searchNum = 0;
    cin >> searchNum;
    bool found = false;
    for (int i = 0; i < N; i++)
    {
        for (int j = 0; j < M; j++)
        {
            if (arr[i][j] == searchNum)
            {
                found = true;
                break;
            }
        }
    }

    if (found)
        cout << "will not take number";
    else
        cout << "will take number";
    return 0;
}
