#include <iostream>
#include <string>

using namespace std;

int main()
{
    int A, B;
    cin >> A >> B;
    int arr[A][B];
    for (int i = 0; i < A; i++)
    {
        for (int j = 0; j < B; j++)
        {
            cin >> arr[i][j];
        }
    }

    for (int i = 0; i < A; i++)
    {
        for (int j = B - 1; j >= 0; j--)
        {
            cout << arr[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}
