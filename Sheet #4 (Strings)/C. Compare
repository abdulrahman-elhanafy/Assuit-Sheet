#include <iostream>
#include <string>
using namespace std;

int main()
{
  string X, Y;
  cin >> X >> Y;
  int Xsum = 0, Ysum = 0;
  for (int i = 0; i < X.length(); i++)
  {
    Xsum += X[i];
  }
  for (int i = 0; i < Y.length(); i++)
  {
    Ysum += Y[i];
  }
  if (Ysum < Xsum)
  {
    cout << Y;
  }
  else
    cout << X;
  return 0;
}