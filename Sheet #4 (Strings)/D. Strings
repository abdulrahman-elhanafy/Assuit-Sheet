#include <iostream>
#include <string>
using namespace std;

int main()
{
  string A, B;
  cin >> A >> B;
  int lA, lB;
  lA = A.size();
  lB = B.size();

  // First Line:
  cout << lA << " " << lB << endl;

  // Second Line:
  cout << A + B << endl;

  // Third Line:
  char temp = A[0];
  A[0] = B[0];
  B[0] = temp;
  cout << A << " " << B;
  return 0;
}