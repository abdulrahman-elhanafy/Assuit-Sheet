#include <iostream>
#include <string>
#include <cctype>
using namespace std;

int main()
{
  string S;
  getline(cin, S);
  for (int i = 0; i < S.length(); i++)
  {
    if (isupper(S[i]))
    {
      S[i] = tolower(S[i]);
    }
    else if (islower(S[i]))
    {
      S[i] = toupper(S[i]);
    }
    else if (S[i] == ',')
    {
      S[i] = ' ';
    }
  }
  cout << S;

  return 0;
}