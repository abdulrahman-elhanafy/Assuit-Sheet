#include <iostream>
#include <string>
using namespace std;

int main()
{
  string X;
  cin >> X;
  int freq[26] = {0};
  for (int i = 0; i < X.length(); i++)
  {
    freq[X[i] - 'a']++;
  }
  for (int i = 0; i < 26; i++)
  {
    if (freq[i] > 0)
    {
      cout << (char)('a' + i) << " : " << freq[i] << endl;
    }
  }
  return 0;
}